# Copia este fichero a .env y rellena lo que necesites. .env está en .gitignore.

# Token de Hugging Face (solo hace falta para modelos con acceso restringido)
HF_TOKEN=

# Dónde guardar los modelos descargados. En la DGX conviene apuntar a un disco compartido.
HF_HOME=./hf_cache

# Qué GPUs ve el proceso. En la DGX NO lo toquéis: SLURM lo fija a la partición que os asigna.
# Solo tiene sentido en una máquina propia con varias GPUs, por ejemplo "0" o "2,3".
# CUDA_VISIBLE_DEVICES=0

# Puerto de la API
ARCA_API_PORT=8000

# Fase 1: tras entrenar, apuntar al LoRA GRPO final o a su repo de Hugging Face.
# Dejar vacío antes del entrenamiento: /reasoning quedará pendiente, no simulará resultados.
# ARCA_RLM_ADAPTER=runs/phase1-rebuild/weights/grpo_lora
ARCA_RLM_ADAPTER=
# ARCA_RLM_BASE_MODEL=Qwen/Qwen3-0.6B

# Salen en /health
ARCA_TEAM=
ARCA_DOMAIN="IMV y CAPI"

# ngrok: token en https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Dominio estático gratuito (dashboard -> Domains) para que la URL no cambie:
# NGROK_ARGS=--url=<vuestro-dominio>.ngrok-free.app

# Fase 2: predeterminado modelo base para usar herramientas; rlm requiere LoRA entrenado.
ARCA_TOOLS_BRAIN=base
ARCA_TOOLS_MODEL_ID=Qwen/Qwen3-1.7B
# Para reutilizar el adaptador de fase 1, ajustar al mismo modelo base:
# ARCA_TOOLS_BRAIN=rlm
# ARCA_TOOLS_ADAPTER=/ruta/al/grpo_lora
ARCA_TOOLS_ADAPTER=
# BOE opcional: 1 añade consultar_boe; 0 conserva el benchmark con tres herramientas.
ARCA_TOOLS_ENABLE_BOE=1
# Directorio persistente y privado para informes generados por petición explícita.
ARCA_IMV_REPORTS_DIR=/data/reports
# Trazas completas opcionales (contienen datos personales). No activar en demos públicas.
# ARCA_TOOLS_TRACE_DIR=/data/traces
# Fase 3 (RAG): generador de /rag. ARCA_RAG_CHUNKING, ARCA_RAG_LAMBDA y ARCA_RAG_MIN_SCORE afinan la recuperación.
# ARCA_RAG_MODEL=Qwen/Qwen3-1.7B
# Fase 4 (agente, POST /agent): cerebros base / rlm (= ARCA_RLM_ADAPTER) / thinking (Qwen3 con
# razonamiento nativo). Por defecto los tres usan Qwen/Qwen3-1.7B y reutilizan los modelos ya
# cargados por /tools y /reasoning (una sola copia en GPU).
# ARCA_AGENT_BASE_MODEL=Qwen/Qwen3-1.7B
# ARCA_THINKING_MODEL=Qwen/Qwen3-1.7B
# ARCA_AGENT_TOKEN_BUDGET=6000
# ARCA_AGENT_RETRIEVER=hybrid
# ARCA_AGENT_TOOL_TIMEOUT=30
# Visor de trazas (uv run --extra agent python -m agent.ui) contra la API:
# ARCA_API_URL=http://localhost:8000
