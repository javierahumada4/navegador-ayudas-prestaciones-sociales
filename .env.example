# Copia este fichero a .env y rellena lo que necesites. .env está en .gitignore.

# Token de Hugging Face (solo hace falta para modelos con acceso restringido)
HF_TOKEN=

# Dónde guardar los modelos descargados. En la DGX conviene apuntar a un disco compartido.
HF_HOME=./hf_cache

# Qué GPUs ve el proceso. En la DGX NO lo toquéis: SLURM lo fija a la partición que os asigna.
# Solo tiene sentido en una máquina propia con varias GPUs, por ejemplo "0" o "2,3".
# CUDA_VISIBLE_DEVICES=0

# Puerto de la API
ARCA_API_PORT=8000

# Fase 1: tras entrenar, apuntar al LoRA GRPO final o a su repo de Hugging Face.
# Dejar vacío antes del entrenamiento: /reasoning quedará pendiente, no simulará resultados.
# ARCA_RLM_ADAPTER=runs/phase1-rebuild/weights/grpo_lora
ARCA_RLM_ADAPTER=
# ARCA_RLM_BASE_MODEL=Qwen/Qwen3-0.6B


# Fase 2: elegir el mismo modelo base para comparar Base+Tools vs RLM+Tools.
# Base por defecto (sin LoRA):
ARCA_TOOLS_BRAIN=base
ARCA_TOOLS_MODEL_ID=Qwen/Qwen3-1.7B
# En modo rlm, apuntar al adaptador GRPO entrenado en ese mismo modelo base:
# ARCA_TOOLS_BRAIN=rlm
# ARCA_TOOLS_ADAPTER=runs/phase1-rebuild/weights/grpo_lora
# También acepta ARCA_RLM_ADAPTER si ARCA_TOOLS_ADAPTER está vacío.
ARCA_TOOLS_ADAPTER=
# Límite por generación (un JSON grande de calcular_imv puede necesitar 2048 tokens):
ARCA_TOOLS_MAX_NEW_TOKENS=2048
# Mismo modo de pensamiento para los dos brazos del experimento.
ARCA_TOOLS_ENABLE_THINKING=false

# Salen en /health
ARCA_TEAM=
ARCA_DOMAIN="IMV y CAPI"

# ngrok: token en https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Dominio estático gratuito (dashboard -> Domains) para que la URL no cambie:
# NGROK_ARGS=--url=<vuestro-dominio>.ngrok-free.app
